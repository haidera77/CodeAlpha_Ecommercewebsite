<div class="container">
  <div class="admin-header">
    <h1>Manage Products</h1>
    <a href="/products/admin/new" class="btn btn-primary">
      <i class="fas fa-plus"></i> Add New Product
    </a>
  </div>
  
  <% if (products.length === 0) { %>
    <div class="empty-state">
      <i class="fas fa-box-open"></i>
      <h3>No products yet</h3>
      <p>Add your first product to get started</p>
      <a href="/products/admin/new" class="btn btn-primary">Add Product</a>
    </div>
  <% } else { %>
    <div class="admin-table">
      <table>
        <thead>
          <tr>
            <th>Image</th>
            <th>Name</th>
            <th>Category</th>
            <th>Price</th>
            <th>Stock</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% products.forEach(product => { %>
            <tr>
              <td><img src="<%= product.image %>" alt="<%= product.name %>"></td>
              <td><strong><%= product.name %></strong></td>
              <td><%= product.category %></td>
              <td>$<%= product.price.toFixed(2) %></td>
              <td><%= product.stock %></td>
              <td>
                <div class="action-btns">
                  <a href="/products/<%= product._id %>" class="btn btn-small" style="background: var(--secondary-color); color: white;">
                    <i class="fas fa-eye"></i>
                  </a>
                  <a href="/products/admin/<%= product._id %>/edit" class="btn btn-small btn-primary">
                    <i class="fas fa-edit"></i>
                  </a>
                  <form action="/products/admin/<%= product._id %>/delete" method="POST" style="display: inline;">
                    <button type="submit" class="btn btn-small btn-danger" onclick="return confirm('Are you sure?')">
                      <i class="fas fa-trash"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>