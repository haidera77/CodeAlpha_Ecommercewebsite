<div class="container">
  <div class="page-header">
    <h1><%= product._id ? 'Edit' : 'Add' %> Product</h1>
  </div>
  
  <div style="background: white; padding: 2rem; border-radius: var(--radius); box-shadow: var(--shadow); max-width: 800px;">
    <form action="/products/admin<%= product._id ? '/' + product._id : '' %>" method="POST">
      
      <div class="form-group">
        <label>Product Name *</label>
        <input type="text" name="name" value="<%= product.name || '' %>" required placeholder="Enter product name">
      </div>
      
      <div class="form-group">
        <label>Description *</label>
        <textarea name="description" rows="5" required placeholder="Enter product description" style="width: 100%; padding: 0.75rem; border: 1px solid var(--border-color); border-radius: var(--radius); font-family: inherit;"><%= product.description || '' %></textarea>
      </div>
      
      <div class="form-row">
        <div class="form-group">
          <label>Price ($) *</label>
          <input type="number" step="0.01" min="0" name="price" value="<%= product.price || '' %>" required placeholder="0.00">
        </div>
        
        <div class="form-group">
          <label>Stock *</label>
          <input type="number" min="0" name="stock" value="<%= product.stock || 0 %>" required placeholder="0">
        </div>
      </div>
      
      <div class="form-row">
        <div class="form-group">
          <label>Category *</label>
          <select name="category" required>
            <option value="">Select Category</option>
            <% ['Electronics', 'Fashion', 'Home & Kitchen', 'Sports', 'Books', 'Beauty', 'Toys', 'Other'].forEach(cat => { %>
              <option value="<%= cat %>" <%= product.category === cat ? 'selected' : '' %>><%= cat %></option>
            <% }) %>
          </select>
        </div>
        
        <div class="form-group">
          <label>Featured Product</label>
          <select name="featured">
            <option value="false" <%= product.featured === false ? 'selected' : '' %>>No</option>
            <option value="true" <%= product.featured === true ? 'selected' : '' %>>Yes</option>
          </select>
        </div>
      </div>
      
      <div class="form-group">
        <label>Image URL *</label>
        <input type="url" name="image" value="<%= product.image || '' %>" required placeholder="https://example.com/image.jpg">
        <small style="color: var(--text-light);">Use Unsplash, Imgur, or any image hosting service</small>
      </div>
      
      <div style="display: flex; gap: 1rem; margin-top: 2rem;">
        <button type="submit" class="btn btn-primary btn-lg">
          <i class="fas fa-save"></i>
          <%= product._id ? 'Update' : 'Create' %> Product
        </button>
        <a href="/products/admin/all" class="btn btn-lg" style="background: var(--border-color); color: var(--text-color);">
          <i class="fas fa-times"></i>
          Cancel
        </a>
      </div>
    </form>
  </div>
</div>