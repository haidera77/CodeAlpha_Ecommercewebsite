<div class="container">
  <div class="product-detail">
    <div class="product-gallery">
      <img src="<%= product.image %>" alt="<%= product.name %>">
    </div>
    
    <div class="product-info-detail">
      <span class="category"><%= product.category %></span>
      <h1><%= product.name %></h1>
      
      <div class="product-rating">
        <% for (let i = 1; i <= 5; i++) { %>
          <i class="fas fa-star <%= i <= product.rating ? 'filled' : '' %>"></i>
        <% } %>
        <span>(<%= product.reviews %> reviews)</span>
      </div>
      
      <div class="product-price-detail">
        <span class="price">$<%= product.price.toFixed(2) %></span>
      </div>
      
      <div class="stock-status">
        <% if (product.stock > 0) { %>
          <i class="fas fa-check-circle"></i>
          <span>In Stock (<%= product.stock %> available)</span>
        <% } else { %>
          <i class="fas fa-times-circle"></i>
          <span>Out of Stock</span>
        <% } %>
      </div>
      
      <div class="product-description">
        <h3>Description</h3>
        <p><%= product.description %></p>
      </div>
      
      <% if (product.stock > 0) { %>
        <form action="/cart/add/<%= product._id %>" method="POST" class="add-to-cart-form">
          <button type="submit" class="btn btn-primary btn-lg">
            <i class="fas fa-shopping-cart"></i>
            Add to Cart
          </button>
        </form>
      <% } else { %>
        <button class="btn btn-disabled btn-lg" disabled>
          <i class="fas fa-times-circle"></i>
          Out of Stock
        </button>
      <% } %>
      
      <div class="product-features">
        <h3>Features</h3>
        <ul>
          <li><i class="fas fa-truck"></i> Free shipping on orders over $100</li>
          <li><i class="fas fa-undo"></i> 30-day return policy</li>
          <li><i class="fas fa-shield-alt"></i> 1-year warranty</li>
          <li><i class="fas fa-headset"></i> 24/7 customer support</li>
        </ul>
      </div>
    </div>
  </div>
  
  <% if (relatedProducts.length > 0) { %>
    <section class="related-products">
      <h2>Related Products</h2>
      <div class="products-grid">
        <% relatedProducts.forEach(prod => { %>
          <div class="product-card">
            <div class="product-image">
              <img src="<%= prod.image %>" alt="<%= prod.name %>">
            </div>
            <div class="product-info">
              <h3><%= prod.name %></h3>
              <div class="product-price">
                <span class="price">$<%= prod.price.toFixed(2) %></span>
              </div>
              <a href="/products/<%= prod._id %>" class="btn btn-primary">View Details</a>
            </div>
          </div>
        <% }) %>
      </div>
    </section>
  <% } %>
</div>